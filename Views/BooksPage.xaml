<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="BiblioCampus.Views.BooksPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BiblioCampus.ViewModels"
             xmlns:models="clr-namespace:BiblioCampus.Models"
             x:DataType="vm:BooksViewModel"
             Title="Catalogue">

    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="8">
        <SearchBar Placeholder="Titre, auteur, ISBN, catégorie…"
                   Text="{Binding SearchText}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Books}">
            <CollectionView.EmptyView>
                <Label Text="Aucun livre trouvé." HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Book">
                    <Border Margin="0,0,0,8" Padding="12" StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Author}" FontSize="13" />
                                <Label Text="{Binding Category}" FontSize="12" Opacity="0.7" />
                                <Label Text="{Binding AvailabilityText}" FontSize="12" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Emprunter" VerticalOptions="Center"
                                    IsEnabled="{Binding IsAvailable}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BooksViewModel}}, Path=BorrowCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
